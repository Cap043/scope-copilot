<file path="components/projects/request/request-form.tsx">
"use client";

import { useState } from "react";
import type { FormEvent } from "react";
import { ArrowRight, Check, MessageSquare, Sparkles } from "lucide-react";

import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Label } from "@/components/ui/label";

type RequestFormProps = {
  hasScopeBaseline: boolean;
};

export function RequestForm({
  hasScopeBaseline,
}: RequestFormProps) {
  const [request, setRequest] = useState("");
  const [submitted, setSubmitted] = useState(false);

  function handleSubmit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();

    const trimmed = request.trim();

    if (!trimmed) {
      return;
    }

    // UI-only for now. Persistence and AI analysis come with ClientRequest.
    setSubmitted(true);
  }

  return (
    <Card>
      <CardHeader className="border-b px-5 py-4 sm:px-6">
        <div className="flex items-start gap-3">
          <div className="flex size-9 shrink-0 items-center justify-center rounded-lg bg-muted">
            <MessageSquare className="size-4 text-muted-foreground" />
          </div>

          <div>
            <CardTitle>Client request</CardTitle>

            <p className="mt-1 text-sm leading-relaxed text-muted-foreground">
              Capture the client's wording exactly as you received it.
            </p>
          </div>
        </div>
      </CardHeader>

      <CardContent className="p-5 sm:p-6">
        <form onSubmit={handleSubmit} className="space-y-5">
          <div className="space-y-2">
            <Label htmlFor="request">Request details</Label>

            <textarea
              id="request"
              value={request}
              onChange={(event) => {
                setRequest(event.target.value);
                setSubmitted(false);
              }}
              placeholder="Example: Can you also add downloadable monthly reports to the dashboard?"
              className="min-h-64 w-full resize-y rounded-lg border border-input bg-background px-3.5 py-3 text-sm leading-relaxed text-foreground shadow-sm outline-none transition-[border-color,box-shadow] placeholder:text-muted-foreground focus:border-ring focus:ring-2 focus:ring-ring/25"
            />

            <p className="text-xs leading-relaxed text-muted-foreground">
              Keep the original wording. Context can be added when it is
              important to understanding the request.
            </p>
          </div>

          {submitted && (
            <div className="rounded-lg border border-success/15 bg-success/5 p-3.5">
              <div className="flex items-start gap-2.5">
                <Check className="mt-0.5 size-4 shrink-0 text-success" />

                <div>
                  <p className="text-sm font-medium">
                    Request captured for the next analysis step.
                  </p>

                  <p className="mt-1 text-xs leading-relaxed text-muted-foreground">
                    Persistence and AI analysis will be connected when the
                    request engine is implemented.
                  </p>
                </div>
              </div>
            </div>
          )}

          <div className="flex flex-col gap-3 border-t pt-5 sm:flex-row sm:items-center sm:justify-between">
            <div className="flex items-center gap-2 text-xs text-muted-foreground">
              <Sparkles className="size-3.5 text-ai" />

              <span>
                {!hasScopeBaseline
                  ? "Define scope before analysis."
                  : "Ready for scope comparison once analysis is connected."}
              </span>
            </div>

            <Button
              type="submit"
              disabled={!request.trim() || !hasScopeBaseline}
              className="w-full sm:w-auto"
            >
              {submitted ? "Captured" : "Capture request"}

              {submitted ? <Check /> : <ArrowRight />}
            </Button>
          </div>
        </form>
      </CardContent>
    </Card>
  );
}
</file>

