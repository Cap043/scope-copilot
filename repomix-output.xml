    label: "Analyzed",
    variant: "ai",
  },
  REVIEW: {
    label: "Needs review",
    variant: "warning",
  },
  RESOLVED: {
    label: "Resolved",
    variant: "success",
  },
};

export function RequestStatusBadge({
  status,
}: {
  status: RequestStatus;
}) {
  const config = statusConfig[status];

  return <Badge variant={config.variant}>{config.label}</Badge>;
}
