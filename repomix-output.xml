              </div>

              <div className="space-y-3">
                {requests.map((request) => (
                  <RequestCard
                    key={request.id}
                    projectId={project.id}
                    requestId={request.id}
                    title={getRequestTitle(
                      request.originalText,
                    )}
                    preview={getRequestPreview(
                      request.originalText,
                    )}
                    status={
                      request.status as RequestStatus
                    }
