}

/*
 * Scope Copilot design foundation
 *
 * Visual language:
 * - Neutral-first
 * - Blue product identity
 * - Subtle indigo AI layer
 * - Semantic colors for decisions and risk
 * - Minimal shadows
 * - Clear document-oriented hierarchy
 */

:root {
  /* Base surfaces */
  --background: #f8fafc;
  --foreground: #111827;

  --card: #ffffff;
  --card-foreground: #111827;

  --popover: #ffffff;
  --popover-foreground: #111827;

  /* Brand */
  --primary: #2563eb;
  --primary-foreground: #ffffff;

  /* Secondary / supporting surfaces */
  --secondary: #f1f5f9;
  --secondary-foreground: #1f2937;

  --muted: #f1f5f9;
  --muted-foreground: #64748b;

  --accent: #eef2ff;
  --accent-foreground: #3730a3;

  /* Structure */
  --border: #e2e8f0;
  --input: #e2e8f0;
  --ring: #2563eb;

  /* Destructive */
  --destructive: #dc2626;

  /* Semantic states */
  --success: #16a34a;
  --success-foreground: #ffffff;

  --warning: #d97706;
  --warning-foreground: #ffffff;

  --info: #2563eb;
  --info-foreground: #ffffff;

  /* AI */
  --ai: #6366f1;
  --ai-foreground: #ffffff;

  /* Scope decision states */
  --scope-in-scope: #16a34a;
  --scope-courtesy: #64748b;
  --scope-review: #d97706;
  --scope-material: #ea580c;
  --scope-major: #dc2626;

  /* Shape */
  --radius: 0.75rem;

  /* Charts */
  --chart-1: #2563eb;
  --chart-2: #16a34a;
  --chart-3: #d97706;
  --chart-4: #6366f1;
  --chart-5: #64748b;

  /* Sidebar */
  --sidebar: #ffffff;
  --sidebar-foreground: #111827;
  --sidebar-primary: #2563eb;
  --sidebar-primary-foreground: #ffffff;
  --sidebar-accent: #f1f5f9;
  --sidebar-accent-foreground: #111827;
  --sidebar-border: #e2e8f0;
  --sidebar-ring: #2563eb;
}

.dark {
  /* Base surfaces */
  --background: #0b0f14;
