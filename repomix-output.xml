    setType(item.type);
    setLimit(item.limit);
    setRationale("");
    setReferenceId("");
    setError("");
    setRemoving(false);
    setEditing(true);
  }

  function startRemoving() {
    setRationale("");
    setReferenceId("");
    setError("");
    setEditing(false);
    setRemoving(true);
  }

  function cancelAction() {
    setType(item.type);
    setLimit(item.limit);
    setRationale("");
    setReferenceId("");
    setError("");
    setEditing(false);
    setRemoving(false);
