  };
}

export async function approveScopeBaselineAction(
  baselineId: string,
) {
  const baseline = await approveScopeBaseline(baselineId);

  return {
    id: baseline.id,
    version: baseline.version,
    status: baseline.status,
    approvedAt: baseline.approvedAt,
  };
}
