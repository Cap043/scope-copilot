        "org-1",
      );

      findFirst.mockResolvedValue({
        id: "baseline-bad-evidence",
        projectId: "project-1",
        version: 1,
        status: "APPROVED",
        sourceType: "PASTE",
        sourceText:
          "The website includes a homepage.",
        structuredScope: {
          deliverables: [
            {
              id: "homepage",
              title: "Homepage",
              sourceReferences: [
                {
                  quote:
                    "The website includes a payment gateway.",
                },
              ],
              provenance: {
                type:
                  "document_extraction",
              },
              status: "active",
            },
          ],
          features: [],
          exclusions: [],
          clientResponsibilities: [],
          revisionLimits: [],
