import { prisma } from "@/lib/db";
import { getCurrentOrganizationId } from "@/lib/auth-session";
import { extractScope } from "@/lib/ai/scope/extract";
import {
  normalizedScopeSchema,
  validateScopeSourceReferences,
} from "@/lib/scope-schema";

export async function createScopeBaseline(data: {
  projectId: string;
  sourceText: string;
}) {
  const organizationId = await getCurrentOrganizationId();

  const sourceText = data.sourceText.trim();

  if (!sourceText) {
    throw new Error("Scope text cannot be empty.");
  }

  // Enforce organization ownership before processing or persisting scope.
  const project = await prisma.project.findFirst({
    where: {
      id: data.projectId,
      organizationId,
    },
    select: {
      id: true,
    },
  });

  if (!project) {
    throw new Error("Project not found.");
  }

  // Convert the raw SOW into the validated normalized scope structure.
  const structuredScope = await extractScope(sourceText);

  // Each new baseline becomes the next version for this project.
  const latestBaseline = await prisma.scopeBaseline.findFirst({
    where: {
      projectId: project.id,
    },
    orderBy: {
      version: "desc",
    },
    select: {
      version: true,
    },
  });

  const version = (latestBaseline?.version ?? 0) + 1;

  return prisma.scopeBaseline.create({
    data: {
      projectId: project.id,
      version,
      status: "DRAFT",
      sourceType: "PASTE",
      sourceText,
      structuredScope,
    },
  });
}

export async function updateScopeBaseline(data: {
  baselineId: string;
  structuredScope: unknown;
}) {
  const organizationId = await getCurrentOrganizationId();

  // Resolve the baseline through its project so organization isolation
  // is enforced before any scope data can be modified.
  const baseline = await prisma.scopeBaseline.findFirst({
    where: {
      id: data.baselineId,
      project: {
        organizationId,
      },
    },
    select: {
      id: true,
      status: true,
      sourceText: true,
    },
  });

  if (!baseline) {
    throw new Error("Scope baseline not found.");
  }

  // Approved scope is immutable. Future changes must create a new version.
  if (baseline.status !== "DRAFT") {
    throw new Error("Only draft scope baselines can be edited.");
  }

  // Never trust arbitrary JSON from the browser.
  // Validate the complete normalized scope before persistence.
  const parsed = normalizedScopeSchema.safeParse(
    data.structuredScope,
  );

  if (!parsed.success) {
    throw new Error("Invalid scope structure.");
  }

  // Every evidence quote must still exist in the original SOW.
  if (
    !validateScopeSourceReferences(
      parsed.data,
      baseline.sourceText,
    )
  ) {
    throw new Error("Scope contains invalid source references.");
  }

  return prisma.scopeBaseline.update({
    where: {
      id: baseline.id,
    },
    data: {
      structuredScope: parsed.data,
    },
  });
}

export async function approveScopeBaseline(
  baselineId: string,
) {
  const organizationId = await getCurrentOrganizationId();

  // Resolve the baseline through its project to enforce organization
  // isolation before changing its lifecycle state.
  const baseline = await prisma.scopeBaseline.findFirst({
    where: {
      id: baselineId,
      project: {
        organizationId,
      },
    },
    select: {
      id: true,
      status: true,
      sourceText: true,
      structuredScope: true,
    },
  });

  if (!baseline) {
    throw new Error("Scope baseline not found.");
  }

  // Approval is a one-way transition for this version.
  if (baseline.status !== "DRAFT") {
    throw new Error("Only draft scope baselines can be approved.");
  }

  // Validate the stored scope again at the approval boundary.
  // This prevents an invalid baseline from becoming authoritative.
  const parsed = normalizedScopeSchema.safeParse(
    baseline.structuredScope,
  );

  if (!parsed.success) {
    throw new Error("Scope structure is invalid.");
  }

  if (
    !validateScopeSourceReferences(
      parsed.data,
      baseline.sourceText,
    )
  ) {
    throw new Error("Scope contains invalid source references.");
  }

  return prisma.scopeBaseline.update({
    where: {
      id: baseline.id,
    },
    data: {
      status: "APPROVED",
      approvedAt: new Date(),
      structuredScope: parsed.data,
    },
  });
}
