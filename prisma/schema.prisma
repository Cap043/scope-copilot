// Scope Copilot's database models.
//
// Better Auth owns authentication and organization membership.
// Our application models (Client, Project) build on top of that.
//
// Organization = an agency/workspace.
// User         = an authenticated person.
// Member       = connects users to organizations.
// Client       = a client belonging to an organization.
// Project      = a project belonging to an organization and client.
// ClientRequest = a client request evaluated against a specific approved scope version.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Better Auth: User
// -----------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime
  updatedAt     DateTime

  sessions Session[]
  accounts Account[]
  members  Member[]

  revisionReviewDecisions  RevisionReviewDecision[]
  finalizedRevisionReviews RevisionReview[]         @relation("RevisionReviewFinalizedBy")

  @@map("user")
}

// -----------------------------------------------------------------------------
// Better Auth: Session
// -----------------------------------------------------------------------------

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime

  ipAddress String?
  userAgent String?

  activeOrganizationId String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

// -----------------------------------------------------------------------------
// Better Auth: Account
// -----------------------------------------------------------------------------

model Account {
  id         String @id
  accountId  String
  providerId String
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime
  updatedAt DateTime

  @@map("account")
}

// -----------------------------------------------------------------------------
// Better Auth: Verification
// -----------------------------------------------------------------------------

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// -----------------------------------------------------------------------------
// Better Auth Organization plugin
// -----------------------------------------------------------------------------

model Organization {
  id       String  @id
  name     String
  slug     String  @unique
  logo     String?
  metadata String?

  members     Member[]
  invitations Invitation[]

  clients  Client[]
  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("organization")
}

// -----------------------------------------------------------------------------
// Better Auth Organization membership
//
// This replaces the old User.organizationId relationship.
// A user belongs to an organization through this model.
// -----------------------------------------------------------------------------

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role      String
  createdAt DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

// -----------------------------------------------------------------------------
// Better Auth Organization invitations
// -----------------------------------------------------------------------------

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email     String
  role      String?
  status    String
  expiresAt DateTime
  inviterId String
  createdAt DateTime

  @@index([organizationId])
  @@map("invitation")
}

// -----------------------------------------------------------------------------
// Scope Copilot: Client
// -----------------------------------------------------------------------------

model Client {
  id    String  @id @default(cuid())
  name  String
  email String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// -----------------------------------------------------------------------------
// Scope Copilot: Project
// -----------------------------------------------------------------------------

model Project {
  id    String  @id @default(cuid())
  name  String
  value Decimal @db.Decimal(12, 2)

  // Dates are optional because the user may not know the timeline
  // when creating a project. Scope changes can affect the timeline later.
  startDate     DateTime?
  targetEndDate DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  scopeBaselines          ScopeBaseline[]
  scopeRevisionCandidates ScopeRevisionCandidate[]
  clientRequests          ClientRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
}

// -----------------------------------------------------------------------------
// Scope Copilot: Scope Baseline
//
// A ScopeBaseline is the structured representation of a project's agreed scope.
// Multiple versions can exist over the lifetime of a project.
//
// The original/normalized source text is retained alongside the AI-extracted
// structure so future decisions can always be grounded in the source material.
// -----------------------------------------------------------------------------

model ScopeBaseline {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  revisionCandidates ScopeRevisionCandidate[] @relation("ScopeBaselineRevisionCandidates")

  // Requests evaluated against this exact baseline.
  clientRequests ClientRequest[] @relation("ClientRequestAnalyzedAgainstBaseline")

  // Baseline versions start at 1 and increase whenever the scope is formally
  // revised. The database constraint prevents duplicate versions per project.
  version Int @default(1)

  // DRAFT     = extracted/edited but not yet approved
  // APPROVED  = the active agreed scope
  // ARCHIVED  = an older approved version
  status String @default("DRAFT")

  // How the scope entered the system.
  // V1: PASTE, PDF, DOCX, TXT
  sourceType String

  // Normalized source content retained for traceability and AI grounding.
  sourceText String @db.Text

  // Structured scope extracted from the source.
  //
  // Expected shape:
  // {
  //   deliverables: [],
  //   features: [],
  //   exclusions: [],
  //   clientResponsibilities: [],
  //   revisionLimits: [],
  //   timeline: {},
  //   assumptions: []
  // }
  structuredScope Json

  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, version])
  @@index([projectId])
}

// -----------------------------------------------------------------------------
// Scope Copilot: Client Request
//
// A ClientRequest is an immutable capture of a client's request.
//
// IMPORTANT:
// analyzedAgainstBaselineId pins the exact approved scope version used for
// evaluation. Future scope versions must never silently change history.
// -----------------------------------------------------------------------------

model ClientRequest {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Exact approved scope baseline used when this request was captured for
  // analysis. Restrict prevents accidental deletion of a referenced baseline.
  analyzedAgainstBaselineId String
  analyzedAgainstBaseline   ScopeBaseline @relation("ClientRequestAnalyzedAgainstBaseline", fields: [analyzedAgainstBaselineId], references: [id], onDelete: Restrict)

  // Preserve the original request wording exactly as captured.
  originalText String @db.Text

  // NEW       = captured, analysis not yet run
  // ANALYZED  = decision engine has produced an analysis
  // REVIEW    = human review required
  // RESOLVED  = request has been resolved
  status String @default("NEW")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, createdAt])
  @@index([analyzedAgainstBaselineId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// Scope Copilot: Scope Revision Candidate
//
// A revision candidate represents a newly supplied SOW that has been extracted
// by AI but has NOT yet become an authoritative scope version.
//
// This is deliberately separate from ScopeBaseline:
// AI output must pass through human reconciliation before V2/V3 is created.
// -----------------------------------------------------------------------------

model ScopeRevisionCandidate {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // The approved baseline this candidate is intended to replace/update.
  baseBaselineId String
  baseBaseline   ScopeBaseline @relation("ScopeBaselineRevisionCandidates", fields: [baseBaselineId], references: [id], onDelete: Cascade)

  // PENDING_REVIEW = extracted and waiting for reconciliation.
  // RECONCILED    = later completed by the reconciliation workflow.
  // DISCARDED     = later explicitly abandoned.
  status String @default("PENDING_REVIEW")

  // How the revised SOW entered the system.
  // 9A currently supports PASTE.
  sourceType String

  // The new SOW itself, retained as immutable candidate evidence.
  sourceText String @db.Text

  // IMPORTANT:
  // This stores ExtractedScope, not NormalizedScope.
  // IDs/provenance belong to the reconciliation/materialization stage.
  extractedScope Json

  // Durable reviewer state for this candidate.
  // There can be only one review workspace per candidate.
  review RevisionReview?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([baseBaselineId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// Scope Copilot: Revision Review
//
// One durable review workspace belongs to one scope revision candidate.
//
// The review itself represents the lifecycle of the reconciliation session.
// Individual reviewer choices are stored separately in RevisionReviewDecision
// so we retain an audit trail rather than overwriting the previous decision.
// -----------------------------------------------------------------------------

model RevisionReview {
  id String @id @default(cuid())

  // One review workspace per revision candidate.
  candidateId String                 @unique
  candidate   ScopeRevisionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // IN_PROGRESS = reviewer can still make decisions.
  // FINALIZING  = finalization has begun.
  // FINALIZED   = candidate became a new scope draft.
  // DISCARDED   = review was explicitly abandoned.
  status String @default("IN_PROGRESS")

  // Set when the review successfully produces the next scope draft.
  finalizedAt DateTime?

  // Reviewer who completed the finalization.
  finalizedById String?
  finalizedBy   User?   @relation("RevisionReviewFinalizedBy", fields: [finalizedById], references: [id], onDelete: Restrict)

  // Full decision history for this review.
  decisions RevisionReviewDecision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// -----------------------------------------------------------------------------
// Scope Copilot: Revision Review Decision
//
// Decisions are intentionally append-only.
//
// If a reviewer changes an item's decision from CARRY_OVER to REMOVE,
// we create another row instead of overwriting the previous one.
//
// The latest decision for an item is the authoritative current decision,
// while older rows remain available as an audit history.
// -----------------------------------------------------------------------------

model RevisionReviewDecision {
  id String @id @default(cuid())

  reviewId String
  review   RevisionReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  // Stable scope item ID from the approved base scope.
  itemId String

  // Scope section containing the reviewed item.
  // Examples:
  // deliverables, features, exclusions, clientResponsibilities,
  // revisionLimits, assumptions
  section String

  // CARRY_OVER or REMOVE
  decision String

  // Authenticated user who made this decision.
  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  // Immutable audit timestamp.
  createdAt DateTime @default(now())

  @@index([reviewId, itemId])
  @@index([actorId])
}
